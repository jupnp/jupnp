<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jupnp.bom</groupId>
    <artifactId>org.jupnp.bom.parent</artifactId>
    <version>3.0.6-SNAPSHOT</version>
  </parent>

  <artifactId>org.jupnp.bom</artifactId>
  <packaging>pom</packaging>

  <name>jUPnP BOM</name>

  <properties>
    <basedirRoot>../..</basedirRoot>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.jupnp</groupId>
      <artifactId>org.jupnp</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jupnp</groupId>
      <artifactId>org.jupnp.android</artifactId>
      <version>${project.version}</version>
      <!-- org.jupnp.android hard-depends on jetty9; exclude it here so it doesn't end up on the
           classpath uninvited for a consumer who explicitly chose a different transport (see below). -->
      <exclusions>
        <exclusion>
          <groupId>org.jupnp</groupId>
          <artifactId>org.jupnp.transport.jetty9</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.jupnp</groupId>
      <artifactId>org.jupnp.osgi</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jupnp</groupId>
      <artifactId>org.jupnp.support</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <!--
    Deliberately no transport dependency here, and no JDK-version-activated profile to auto-pick one:
    which transport to use (org.jupnp.transport.jetty9 or org.jupnp.transport.jetty12) is the consumer's
    choice to make explicitly, not something this aggregator should decide based on which JDK happens to
    build it. That would be an implicit, environment-dependent choice, which is exactly what this PR's
    fail-fast discovery is meant to prevent. Add exactly one transport bundle as a direct dependency
    alongside this one. TransportConfigurationProvider fails fast if ServiceLoader finds more than one.
  -->

</project>
