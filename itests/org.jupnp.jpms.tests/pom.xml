<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Use the root parent to avoid inheriting the OSGi integration test runtime. -->
  <parent>
    <groupId>org.jupnp</groupId>
    <artifactId>jupnp</artifactId>
    <version>4.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <groupId>org.jupnp.itests</groupId>
  <artifactId>org.jupnp.jpms.tests</artifactId>

  <name>jUPnP Integration Tests JPMS</name>

  <properties>
    <basedirRoot>../..</basedirRoot>
    <jpms.transport>org.jupnp.transport.jetty9</jpms.transport>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.jupnp</groupId>
      <artifactId>${jpms.transport}</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jupnp</groupId>
      <artifactId>org.jupnp.support</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jupnp.bom</groupId>
      <artifactId>org.jupnp.bom.test</artifactId>
      <type>pom</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>module-path</id>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <phase>process-test-resources</phase>
            <configuration>
              <includeGroupIds>org.jupnp,org.eclipse.jetty,javax.servlet,org.slf4j</includeGroupIds>
              <includeScope>runtime</includeScope>
              <outputDirectory>${project.build.directory}/module-path/${jpms.transport}</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <jpms.modulePath>${project.build.directory}/module-path/${jpms.transport}</jpms.modulePath>
            <jpms.sources>${project.basedir}/src/test/resources/jpms</jpms.sources>
            <jpms.transport>${jpms.transport}</jpms.transport>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>java17</id>
      <activation>
        <jdk>[17,)</jdk>
      </activation>
      <properties>
        <jpms.transport>org.jupnp.transport.jetty12</jpms.transport>
      </properties>
    </profile>
  </profiles>

</project>
