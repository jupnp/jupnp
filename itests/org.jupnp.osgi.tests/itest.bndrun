-include: ../itest-common.bndrun

-runrequires: \
	bnd.identity;id='org.jupnp.osgi',\
	bnd.identity;id='org.jupnp.osgi.tests',\
	bnd.identity;id='org.apache.aries.spifly.dynamic.bundle',\
	bnd.identity;id='org.jupnp.transport.jetty9'

#
# done
#
# org.apache.aries.spifly.dynamic.bundle and its ASM dependencies are pinned to startlevel=1, and
# org.jupnp.transport.jetty9 (the ServiceLoader/SPI provider bundle) to startlevel=2, so that the
# OSGi Service Loader Mediator is active and has registered the transport provider before org.jupnp
# (unmarked, defaulting to startlevel=3) performs its first ServiceLoader-based discovery.
#
# TransportConfigurationProvider does briefly retry ServiceLoader discovery before falling back to
# reflection, but that alone is not enough here: measured empirically, the gap between org.jupnp's
# first attempt and jetty9 actually registering with the mediator spans however long the framework
# takes to work through the other bundles in its startup sequence first, not a few milliseconds of
# jitter. Closing that gap with a bounded retry would require a multi-second budget, which is an
# unacceptable startup cost for the (common) case of no mediator being present at all. So this
# specific test -- which targets the ServiceLoader/SPI Fly path used by non-DS consumers such as this
# module's own JettyUpnpServiceConfiguration -- still needs explicit ordering. Note that
# org.jupnp.OSGiUpnpServiceConfiguration (the actual shipped OSGi component) no longer depends on this
# race at all: it consumes TransportConfiguration via a mandatory Declarative Services @Reference,
# which defers activation until the transport bundle has registered, deterministically.
#
# CAVEAT: the startlevel attribute below is silently dropped whenever the bnd resolver recomputes
# -runbundles (e.g. `mvn ... -DwithResolver`). If this test starts failing with REFLECTIVE_FALLBACK
# after a resolver run, re-add ;startlevel=1 to spifly/asm and ;startlevel=2 to jetty9 below.
-runbundles: \
	biz.aQute.tester.junit-platform;version='[7.4.0,7.4.1)',\
	javax.servlet-api;version='[3.1.0,3.1.1)',\
	org.apache.aries.spifly.dynamic.bundle;version='[1.3.7,1.3.8)';startlevel=1,\
	org.eclipse.equinox.event;version='[1.4.300,1.4.301)',\
	org.opentest4j;version='[1.3.0,1.3.1)',\
	org.osgi.service.component;version='[1.5.0,1.5.1)',\
	org.osgi.service.event;version='[1.4.1,1.4.2)',\
	org.osgi.service.upnp;version='[1.2.1,1.2.2)',\
	org.osgi.util.function;version='[1.0.0,1.0.1)',\
	org.osgi.util.promise;version='[1.0.0,1.0.1)',\
	junit-jupiter-api;version='[5.10.1,5.10.2)',\
	junit-jupiter-engine;version='[5.10.1,5.10.2)',\
	junit-platform-commons;version='[1.10.1,1.10.2)',\
	junit-platform-engine;version='[1.10.1,1.10.2)',\
	junit-platform-launcher;version='[1.10.1,1.10.2)',\
	org.apache.felix.scr;version='[2.2.10,2.2.11)',\
	org.eclipse.jetty.http;version='[9.4.53,9.4.54)',\
	org.eclipse.jetty.io;version='[9.4.53,9.4.54)',\
	org.eclipse.jetty.jaas;version='[9.4.53,9.4.54)',\
	org.eclipse.jetty.security;version='[9.4.53,9.4.54)',\
	org.eclipse.jetty.server;version='[9.4.53,9.4.54)',\
	org.eclipse.jetty.servlet;version='[9.4.53,9.4.54)',\
	org.eclipse.jetty.util;version='[9.4.53,9.4.54)',\
	org.eclipse.jetty.util.ajax;version='[9.4.53,9.4.54)',\
	org.eclipse.jetty.xml;version='[9.4.53,9.4.54)',\
	org.ops4j.pax.logging.pax-logging-api;version='[2.3.4,2.3.5)',\
	org.ops4j.pax.web.pax-web-api;version='[8.0.25,8.0.26)',\
	org.ops4j.pax.web.pax-web-jetty;version='[8.0.25,8.0.26)',\
	org.ops4j.pax.web.pax-web-runtime;version='[8.0.25,8.0.26)',\
	org.ops4j.pax.web.pax-web-spi;version='[8.0.25,8.0.26)',\
	org.ops4j.pax.web.pax-web-tomcat-common;version='[8.0.25,8.0.26)',\
	org.jupnp;version='[3.0.6,3.0.7)',\
	org.jupnp.device.simple;version='[3.0.6,3.0.7)',\
	org.jupnp.osgi;version='[3.0.6,3.0.7)',\
	org.jupnp.osgi.tests;version='[3.0.6,3.0.7)',\
	org.objectweb.asm;version='[9.6.0,9.6.1)';startlevel=1,\
	org.objectweb.asm.commons;version='[9.6.0,9.6.1)';startlevel=1,\
	org.objectweb.asm.tree;version='[9.6.0,9.6.1)';startlevel=1,\
	org.objectweb.asm.tree.analysis;version='[9.6.0,9.6.1)';startlevel=1,\
	org.objectweb.asm.util;version='[9.6.0,9.6.1)';startlevel=1,\
	org.eclipse.jetty.client;version='[9.4.53,9.4.54)',\
	org.jupnp.transport.jetty9;version='[3.0.6,3.0.7)';startlevel=2
