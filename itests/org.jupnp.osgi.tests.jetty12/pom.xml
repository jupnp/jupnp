<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jupnp.pom</groupId>
    <artifactId>itests</artifactId>
    <version>3.0.5-SNAPSHOT</version>
  </parent>

  <groupId>org.jupnp.itests</groupId>
  <artifactId>org.jupnp.osgi.tests.jetty12</artifactId>

  <name>jUPnP Integration Tests OSGi Jetty 12</name>

  <properties>
    <basedirRoot>../..</basedirRoot>
    <maven.compiler.release>17</maven.compiler.release>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.jupnp</groupId>
      <artifactId>org.jupnp</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jupnp</groupId>
      <artifactId>org.jupnp.transport.jetty12</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      Pin explicitly: the itests parent pom pulls in org.jupnp.bom.runtime (needed by the other itest
      modules for pax-web-jetty), which transitively drags in jetty-util at the old Jetty 9.4.x version.
      Since it shares the same groupId:artifactId as the Jetty 12.x jetty-util that
      org.jupnp.transport.jetty12 actually needs, Maven's version mediation would otherwise silently drop
      the 12.x one, breaking OSGi resolution (jetty-io/jetty-http import org.eclipse.jetty.util at
      [12.1.0,13)). A direct dependency declaration always wins over a transitive one.
    -->
    <dependency>
      <groupId>org.eclipse.jetty</groupId>
      <artifactId>jetty-util</artifactId>
      <version>${jetty12.version}</version>
    </dependency>
    <!--
      OSGi Service Loader Mediator: only needed here to prove in this itest that
      TransportConfigurationProvider's ServiceLoader-based discovery works across bundles when a
      mediator is present, as it is in the project's primary deployment target (openHAB on Apache
      Karaf, which bundles Aries SPI Fly). Not part of the general runtime BOM, jUPnP itself does not
      require it: without a mediator, TransportConfigurationProvider falls back to reflection.
    -->
    <dependency>
      <groupId>org.apache.aries.spifly</groupId>
      <artifactId>org.apache.aries.spifly.dynamic.bundle</artifactId>
      <version>1.3.7</version>
    </dependency>
  </dependencies>

</project>
