-include: ../../bnd.bnd

Import-Package: com.sun.net.httpserver;resolution:=optional,\
 *

# The transport implementation is discovered at runtime, see TransportConfigurationProvider.
# Two mechanisms are used, in order:
# 1. java.util.ServiceLoader / META-INF/services, bridged across bundles by an OSGi Service Loader
#    Mediator (e.g. Apache Aries SPI Fly) if one is running. The capability below lets such a
#    mediator recognize this bundle as a ServiceLoader consumer for TransportConfiguration and weave
#    the ServiceLoader.load() call so it can see providers from other bundles.
# 2. a reflective fallback (Class.forName) for environments without a Service Loader Mediator, relying
#    on the DynamicImport-Package below to resolve the well-known transport implementation classes.
Require-Capability: osgi.serviceloader;filter:="(osgi.serviceloader=org.jupnp.transport.TransportConfiguration)";cardinality:=multiple;resolution:=optional,\
 osgi.extender;filter:="(osgi.extender=osgi.serviceloader.processor)";resolution:=optional

DynamicImport-Package: org.jupnp.transport.impl.jetty,\
 org.jupnp.transport.impl.jetty12
